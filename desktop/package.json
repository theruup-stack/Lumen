{
  "name": "lumen",
  "productName": "Lumen",
  "version": "1.0.0",
  "description": "Lumen – webbläsare och sökmotor",
  "main": "main.js",
  "author": "Lumen",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "se.lumen.browser",
    "productName": "Lumen",
    "artifactName": "Lumen-${os}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "ui/**/*", "build/icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Lumen" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "icon": "build/icon.png", "category": "public.app-category.productivity", "identity": null },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Network" }
  }
}
